{
  "version": 2,
  "name": "cortexa-frontend",
  "builds": [
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "dashboard.html"
    },
    {
      "src": "/login",
      "dest": "login.html"
    },
    {
      "src": "/register",
      "dest": "register.html"
    },
    {
      "src": "/profile",
      "dest": "profile.html"
    },
    {
      "src": "/index",
      "dest": "index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
